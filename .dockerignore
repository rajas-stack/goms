# Root .dockerignore — scoped for apps/api/Dockerfile's `COPY . .` build stage.
# apps/api only needs: root package.json + package-lock.json (npm workspaces),
# apps/api/**, and packages/domain/** (its one workspace dependency). Everything
# below is either regenerated inside the image (node_modules, dist) or belongs
# to the frontend/mobile app and tooling that apps/api never imports.

.git
node_modules
dist
android
public
/src
docs
scripts
infra

# Editor/OS/tooling cruft
.vscode
.idea
.vite
.superpowers
.vercel
.claude
.impeccable
.playwright-mcp
.worktrees
*.log
tsconfig.tsbuildinfo

# Env files (never belong in an image layer)
.env
.env.*
!.env.example

# Stray root documents, not part of any workspace
*.docx
*.xlsx
*.png
*.zip
**/*.pem
**/*.key
**/*service-account*.json
**/*firebase-adminsdk*.json
**/*credentials*.json
# Only API/domain source and workspace manifests enter the image build context.
**
!package.json
!package-lock.json
!apps/
!apps/api/
!apps/api/**
!packages/
!packages/domain/
!packages/domain/**
**/node_modules
**/dist
**/.env
**/.env.*
**/.npmrc
**/*.pem
**/*.key
**/*service-account*.json
**/*firebase-adminsdk*.json
**/*credentials*.json

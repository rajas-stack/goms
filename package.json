{
  "name": "gorms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace @goms/domain",
    "dev": "vite",
    "dev:keepalive": "node scripts/dev-server-watchdog.mjs",
    "build:preview": "node scripts/build-local-preview.mjs",
    "build": "tsc -b && node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:component": "vitest run --config vitest.component.config.ts",
    "seed:import": "tsx scripts/seed-import.ts",
    "build-import-fixtures": "tsx scripts/admin-import-fixtures/build-fixtures.ts",
    "rbac:manifest": "node scripts/rbac-manifest.mjs",
    "sync:local": "node scripts/local-sync.mjs",
    "sync:status": "node scripts/local-sync.mjs --status",
    "sync:pause": "node scripts/local-sync.mjs --pause",
    "sync:resume": "node scripts/local-sync.mjs --resume"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@floating-ui/dom": "^1.8.0",
    "@goms/domain": "*",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.19",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@trpc/client": "^11.19.0",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "docx-preview": "0.4.1",
    "firebase": "^13.0.0",
    "framer-motion": "^14.2.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@turf/simplify": "^7.4.0",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "7zip-min": "^3.0.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.2",
    "pg": "^8.23.1",
    "polygon-clipping": "^0.15.7",
    "postcss": "^8.5.30",
    "proj4": "^2.22.0",
    "shapefile": "^0.6.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "xcode": {
      "uuid": "^14.0.3"
    }
  }
}

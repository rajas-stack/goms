# Backend (apps/api) environment variables. Copy to `.env.local` for local
# `npm run dev`, or set directly for tests (`DATABASE_URL=... npm test`).
# In deployed environments (Cloud Run) these are set via Secret Manager /
# environment variables in infra/dev/cloudrun.tf and infra/prod/cloudrun.tf
# — never a committed .env file.

# Required. A real Postgres connection string. No fallback/default — pg's
# Pool is constructed with whatever this resolves to (apps/api/src/db.ts),
# and connections simply fail if it's unset or wrong.
#   Local:       postgresql://postgres:test@localhost:5432/goms_dev
#   CI test job:  postgresql://postgres:test@postgres:5432/goms_test
DATABASE_URL=

# Optional. Comma-separated list of extra allowed CORS origins, merged with
# the hardcoded default (http://localhost:5173, Vite's dev-server origin —
# apps/api/src/app.ts). Set to the deployed frontend origin(s) once frontend
# hosting exists, e.g.:
#   Dev:   CORS_ALLOWED_ORIGINS=https://goms-dev.web.app
#   Prod:  CORS_ALLOWED_ORIGINS=https://<GOMS_PROD_DOMAIN>
CORS_ALLOWED_ORIGINS=

# Optional. HTTP port the Fastify server listens on. Defaults to 8080
# (apps/api/src/server.ts) — Cloud Run's expected default container port.
PORT=

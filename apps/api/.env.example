# Backend (apps/api) environment variables. Copy to `.env.local` for local
# `npm run dev`, or set directly for tests (`DATABASE_URL=... npm test`).
# In deployed environments (Cloud Run) these are set via Secret Manager /
# environment variables in infra/dev/cloudrun.tf and infra/prod/cloudrun.tf
# — never a committed .env file.

# Required. A real Postgres connection string. No fallback/default — pg's
# Pool is constructed with whatever this resolves to (apps/api/src/db.ts),
# and connections simply fail if it's unset or wrong.
#   Local:       postgresql://postgres:test@localhost:5432/goms_dev
#   CI test job:  postgresql://postgres:test@postgres:5432/goms_test
DATABASE_URL=

# Optional. Comma-separated list of extra allowed CORS origins, merged with
# the hardcoded default (http://localhost:5173, Vite's dev-server origin —
# apps/api/src/app.ts). Set to the deployed frontend origin(s) once frontend
# hosting exists, e.g.:
#   Dev:   CORS_ALLOWED_ORIGINS=https://goms-dev.web.app
#   Prod:  CORS_ALLOWED_ORIGINS=https://<GOMS_PROD_DOMAIN>
CORS_ALLOWED_ORIGINS=

# Optional. HTTP port the Fastify server listens on. Defaults to 8080
# (apps/api/src/server.ts) — Cloud Run's expected default container port.
PORT=

# Optional. Declares what proxy sits in front of this process, so `request.ip`
# and the per-IP rate limiter can identify the real caller
# (apps/api/src/client-ip.ts). Unset means trust nothing — the correct default
# for local `npm run dev`, tests, and any directly-reachable deployment.
#   Local/tests:  (leave unset)
#   Cloud Run behind Firebase Hosting's /api/** rewrite:
#                 TRUST_PROXY=firebase-hosting
# Other accepted values: `true` (trust X-Forwarded-For as-is), a hop count
# (e.g. `2`), or a comma-separated IP/CIDR allow-list.
#
# `firebase-hosting` reads the caller from `Fastly-Client-IP`, because that
# rewrite does NOT put the caller in X-Forwarded-For — that header holds
# Google/Fastly CDN addresses identical for every visitor. Note that this
# header is only trustworthy while every request path to this service goes
# through Hosting; a caller reaching the Cloud Run URL directly can set it
# freely (see DRIFT-001 in the 2026-08-27 temporary drift register).
TRUST_PROXY=

# Jev AI API key (https://www.jevai.org/agent/keys), used by
# apps/api/src/lib/jev.ts. SECRET — server-side only.
# Never put this in a frontend `VITE_*` variable: Vite inlines those into the
# public JS bundle, where anyone can read them. The frontend must call JEV
# through this API instead.
#   Local:     put the real key in apps/api/.env.local (git-ignored)
#   Deployed:  Secret Manager secret `jev-api-key`, wired into Cloud Run via
#              infra/dev|prod/cloudrun.tf (secret_key_ref) — never a plain env value.
JEV_API_KEY=
# Optional. Defaults to https://www.jevai.org — leave blank unless Jev changes it.
JEV_API_BASE_URL=

{
  "name": "@goms/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && npm run copy-import-data",
    "copy-import-data": "node -e \"require('fs').cpSync('src/import/data','dist/import/data',{recursive:true})\"",
    "start": "node dist/server.js",
    "test": "vitest run",
    "migrate": "node-pg-migrate"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@goms/domain": "*",
    "@google-cloud/storage": "^7.22.0",
    "@trpc/server": "^11.0.0",
    "fastify": "^5.1.0",
    "firebase-admin": "^14.3.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@trpc/client": "^11.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}

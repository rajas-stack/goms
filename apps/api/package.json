{
  "name": "@goms/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && npm run copy-import-data",
    "copy-import-data": "node -e \"require('fs').cpSync('src/import/data','dist/import/data',{recursive:true})\"",
    "start": "node dist/server.js",
    "test": "vitest run",
    "migrate": "node-pg-migrate"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@goms/domain": "*",
    "@google-cloud/storage": "^8.4.0",
    "@trpc/server": "^11.19.0",
    "fastify": "^5.12.7",
    "firebase-admin": "^14.5.0",
    "node-pg-migrate": "^9.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@trpc/client": "^11.19.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}

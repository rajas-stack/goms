# Copy to docker/onlyoffice/.env (git-ignored) and replace the placeholders. Never commit real values.
POSTGRES_USER=goms
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_DB=goms
# 32+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# Must equal ONLYOFFICE_JWT_SECRET in apps/api/.env.local.
ONLYOFFICE_JWT_SECRET=replace-with-32-plus-random-characters

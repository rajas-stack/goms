# Dependencies
node_modules/

# Build output
dist/

# tsc -b incremental cache (regenerated by `npm run build`)
tsconfig.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# Editor files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Raw village-boundary shapefiles (per-state). Bulky source archives used
# only by scripts/generate-village-data.cjs to build src/assets/village-shapes/;
# not needed at runtime once converted.
/*.zip

# Vite
.vite/

# Coverage
coverage/
.vercel
.superpowers/

# Playwright MCP scratch output (page snapshots, console logs, screenshots).
# Regenerated on every browser-driven check and never read back by the app —
# one debugging session alone drops hundreds of files here.
.playwright-mcp/

# Local isolated workspaces for subagent-driven plan execution.
.worktrees/

